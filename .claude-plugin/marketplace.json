  "renames": {
    "query-plan-analysis": "sqlserver-query-plans"
  },
  "plugins": [
    {
      "name": "sqlserver-query-plans",
      "displayName": "SQL Server Query Plans",
      "source": "./plugins/sqlserver-query-plans",
      "description": "Read a SQL Server execution plan and explain what is actually slow, and why. Prevents the standard wrong conclusions: cost percentages read as measurements, operators ranked by cumulative time, estimated rows compared to actual without dividing by executions, and missing-index DDL pasted verbatim.",
      "version": "1.5.4",
      "author": {
        "name": "Erik Darling",
        "email": "erik@erikdarling.com",
        "url": "https://erikdarling.com"
      },
      "homepage": "https://erikdarling.com",
      "repository": "https://github.com/erikdarlingdata/claude-plugins",
      "license": "MIT",
      "category": "database",
      "keywords": [
        "sql-server",
        "mssql",
        "query-plan",
        "execution-plan",
        "showplan",
        "sqlplan",
        "performance",
        "query-tuning",
        "tsql",
        "dba"
      ],
      "tags": [
        "sql-server",
        "mssql",
        "query-plan",
        "execution-plan",
        "showplan",
        "sqlplan",
        "performance",
        "query-tuning",
        "tsql",
        "dba"
      ]
    },
    {
      "name": "subagent-fence",
      "displayName": "Subagent Fence",
      "source": "./plugins/subagent-fence",
      "description": "Refuses force-pushes, pushes to protected branches, git commands that skip hooks and kills by process name; optionally bans folders, keeps subagents out of shared checkouts and stops whole-file reads of big files.",
      "version": "1.0.0",
      "author": {
        "name": "Erik Darling",
        "email": "erik@erikdarling.com",
        "url": "https://erikdarling.com"
      },
      "homepage": "https://erikdarling.com",
      "repository": "https://github.com/erikdarlingdata/claude-plugins",
      "license": "MIT",
      "category": "productivity",
      "keywords": [
        "subagents",
        "git",
        "guardrails",
        "safety",
        "multi-agent"
      ],
      "tags": [
        "subagents",
        "git",
        "guardrails",
        "safety",
        "multi-agent"
      ]
    },
    {
      "name": "model-allowlist",
      "displayName": "Model Allowlist",
      "source": "./plugins/model-allowlist",
      "description": "Refuses a subagent spawn that names a pinned model id, and enforces your own per-agent-type model rules.",
      "version": "1.0.0",
      "author": {
        "name": "Erik Darling",
        "email": "erik@erikdarling.com",
        "url": "https://erikdarling.com"
      },
      "homepage": "https://erikdarling.com",
      "repository": "https://github.com/erikdarlingdata/claude-plugins",
      "license": "MIT",
      "category": "productivity",
      "keywords": [
        "subagents",
        "models",
        "guardrails",
        "multi-agent"
      ],
      "tags": [
        "subagents",
        "models",
        "guardrails",
        "multi-agent"
      ]
    },
    {
      "name": "seat-resume",
      "displayName": "Session Resume",
      "source": "./plugins/seat-resume",
      "description": "Keeps a registry of interactive sessions so /resume-sessions can list and reopen the ones a crash, reboot or closed terminal interrupted. Windows, PowerShell, WezTerm or Windows Terminal.",
      "version": "1.0.0",
      "author": {
        "name": "Erik Darling",
        "email": "erik@erikdarling.com",
        "url": "https://erikdarling.com"
