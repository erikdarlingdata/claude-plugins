    {
      "name": "sqlserver-query-plans",
      "displayName": "SQL Server Query Plans",
      "source": "./plugins/sqlserver-query-plans",
      "description": "Read a SQL Server execution plan and explain what is actually slow, and why. Prevents the standard wrong conclusions: cost percentages read as measurements, operators ranked by cumulative time, estimated rows compared to actual without dividing by executions, and missing-index DDL pasted verbatim.",
      "version": "1.5.4",
      "author": {
        "name": "Erik Darling",
        "email": "erik@erikdarling.com",
        "url": "https://erikdarling.com"
      },
      "homepage": "https://erikdarling.com",
      "repository": "https://github.com/erikdarlingdata/claude-plugins",
      "license": "MIT",
      "category": "database",
