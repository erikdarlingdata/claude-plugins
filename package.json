{
  "name": "darling-data-plugins",
  "version": "1.2.0",
  "description": "Darling Data plugins for pi, Claude Code, and Copilot CLI: SQL Server query plan analysis, a pi session auto-resume extension, and a pi subagent watchdog",
  "license": "MIT",
  "author": "Erik Darling (https://erikdarling.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikdarlingdata/claude-plugins.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "pi-package",
    "sql-server",
    "query-plans",
    "skills",
    "session-resume",
    "subagents",
    "watchdog"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "skills": ["./plugins/*/skills"],
    "extensions": ["./plugins/*/extensions"]
  }
}
